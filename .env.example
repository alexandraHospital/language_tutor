# LLM API base URL
# Ollama: http://127.0.0.1:11434/v1
# External provider: use the provider's API base URL
BASE_URL=http://127.0.0.1:11434/v1

# API key for the selected external provider
# Not required when using Ollama locally
API_KEY=

# Path to the Whisper model
DEFAULT_WHISPER_PATH=/path/to/whisper.cpp/
